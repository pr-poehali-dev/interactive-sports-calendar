{
  "tests": [
    {
      "name": "List events",
      "method": "GET",
      "path": "/?action=list&resource=events",
      "expectedStatus": 200,
      "bodyMatcher": "partial"
    },
    {
      "name": "Check duplicate email",
      "method": "POST",
      "path": "/?action=register",
      "body": {
        "email": "admin@system.local",
        "password": "password123",
        "name": "Test User",
        "phone": "+7 999 123 45 67",
        "user_type": "individual"
      },
      "expectedStatus": 400,
      "expectedBody": {
        "error": "string"
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Login user",
      "method": "POST",
      "path": "/?action=login",
      "body": {
        "email": "admin@system.local",
        "password": "admin123"
      },
      "expectedStatus": 200,
      "expectedBody": {
        "success": true,
        "user": {
          "email": "string"
        }
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Update event - forbidden for non-owner",
      "method": "PUT",
      "path": "/?resource=events&action=update&event_id=99999",
      "body": {
        "title": "Test",
        "requester_email": "unknown@test.com",
        "is_admin": false
      },
      "expectedStatus": 404,
      "expectedBody": {
        "error": "string"
      },
      "bodyMatcher": "partial"
    }
  ]
}