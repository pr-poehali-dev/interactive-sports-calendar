{
  "tests": [
    {
      "name": "List events with media",
      "method": "GET",
      "path": "/?action=list&resource=events",
      "expectedStatus": 200,
      "bodyMatcher": "partial"
    },
    {
      "name": "Check duplicate email",
      "method": "POST",
      "path": "/?action=register",
      "body": {
        "email": "admin@system.local",
        "password": "password123",
        "name": "Test User",
        "phone": "+7 999 123 45 67",
        "user_type": "individual"
      },
      "expectedStatus": 400,
      "expectedBody": {
        "error": "string"
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Login user",
      "method": "POST",
      "path": "/?action=login",
      "body": {
        "email": "admin@system.local",
        "password": "admin123"
      },
      "expectedStatus": 200,
      "expectedBody": {
        "success": true,
        "user": {
          "email": "string"
        }
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Update event - forbidden for non-owner",
      "method": "PUT",
      "path": "/?resource=events&action=update&event_id=99999",
      "body": {
        "title": "Test",
        "requester_email": "unknown@test.com",
        "is_admin": false
      },
      "expectedStatus": 404,
      "expectedBody": {
        "error": "string"
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Save files - event not found",
      "method": "PUT",
      "path": "/?resource=events&action=save-files&event_id=99999",
      "body": {
        "documents": [],
        "requester_email": "unknown@test.com",
        "is_admin": false
      },
      "expectedStatus": 404,
      "expectedBody": {"error": "string"},
      "bodyMatcher": "partial"
    },
    {
      "name": "Report event - not found",
      "method": "PUT",
      "path": "/?resource=events&action=report&event_id=99999",
      "body": {
        "actual_participants": 10,
        "requester_email": "unknown@test.com",
        "is_admin": false
      },
      "expectedStatus": 404,
      "expectedBody": {"error": "string"},
      "bodyMatcher": "partial"
    },
    {
      "name": "Delete file - bad request",
      "method": "DELETE",
      "path": "/?resource=events&action=delete-file&event_id=1",
      "body": {
        "url": "",
        "table": "wrong",
        "is_admin": false
      },
      "expectedStatus": 400,
      "expectedBody": {"error": "string"},
      "bodyMatcher": "partial"
    },
    {
      "name": "Update profile - missing user_id",
      "method": "POST",
      "path": "/?action=update-profile",
      "body": {"name": "Test"},
      "expectedStatus": 400,
      "expectedBody": {"error": "string"},
      "bodyMatcher": "partial"
    },
    {
      "name": "List profile changes",
      "method": "GET",
      "path": "/?action=list-profile-changes&status=pending",
      "expectedStatus": 200,
      "expectedBody": {"changes": []},
      "bodyMatcher": "partial"
    },
    {
      "name": "Approve profile change - not found",
      "method": "PUT",
      "path": "/?action=approve-profile-change&change_id=99999",
      "expectedStatus": 404,
      "expectedBody": {"error": "string"},
      "bodyMatcher": "partial"
    }
  ]
}